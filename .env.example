# Copy to backend/.env for local overrides. Every value here is optional.

# SQLite by default; set a Postgres URL in production.
DATABASE_URL=sqlite:///./dispatch.db
# DATABASE_URL=postgresql://user:password@localhost:5432/dispatch

# Depot location (defaults to Cheshire, CT)
DEPOT_NAME=Cheshire Depot
DEPOT_LAT=41.4990
DEPOT_LNG=-72.9007

# Routing assumptions
AVG_SPEED_KMH=50
ROAD_FACTOR=1.3
SERVICE_MINUTES=5
SHIFT_MINUTES=600
SOLVER_TIME_LIMIT_S=3

# Demo behavior
SEED_ON_STARTUP=true
ALLOW_DEMO_RESET=true
CORS_ORIGINS=*
